{
  "name": "한 주",
  "version": "1.0.0",
  "unit": "pt",
  "color": {
    "light": {
      "background": "#F6F5F0",
      "surface": "#FCFBF8",
      "surfaceRaised": "#FFFFFF",
      "textPrimary": "#252C28",
      "textSecondary": "#58625B",
      "textTertiary": "#687168",
      "separator": "#D8DDD5",
      "borderStrong": "#7F8B7C",
      "accent": "#3F6552",
      "accentSubtle": "#E6EDE5",
      "onAccent": "#FFFDF8",
      "success": "#42634B",
      "warning": "#865C24",
      "destructive": "#A33E33",
      "calendar": "#536A7D",
      "paused": "#746342"
    },
    "dark": {
      "background": "#191E1B",
      "surface": "#222924",
      "surfaceRaised": "#2A332C",
      "textPrimary": "#EBEFE6",
      "textSecondary": "#B8C3B8",
      "textTertiary": "#9AA99C",
      "separator": "#3C473E",
      "borderStrong": "#6E8171",
      "accent": "#ABD0B0",
      "accentSubtle": "#303F33",
      "onAccent": "#172A1D",
      "success": "#ACCEAE",
      "warning": "#E8C18A",
      "destructive": "#F0ADA1",
      "calendar": "#A9C5D8",
      "paused": "#D7C398"
    }
  },
  "typography": {
    "display": {
      "size": 44,
      "weight": "regular",
      "lineHeight": 52,
      "relativeTo": "largeTitle",
      "usage": "실행 시간",
      "tracking": 0
    },
    "largeTitle": {
      "size": 32,
      "weight": "semibold",
      "lineHeight": 40,
      "relativeTo": "largeTitle",
      "usage": "화면 제목",
      "tracking": 0
    },
    "title": {
      "size": 24,
      "weight": "semibold",
      "lineHeight": 32,
      "relativeTo": "title2",
      "usage": "시트 제목",
      "tracking": 0
    },
    "sectionTitle": {
      "size": 18,
      "weight": "semibold",
      "lineHeight": 26,
      "relativeTo": "headline",
      "usage": "섹션 제목",
      "tracking": 0
    },
    "body": {
      "size": 17,
      "weight": "regular",
      "lineHeight": 26,
      "relativeTo": "body",
      "usage": "본문",
      "tracking": 0
    },
    "bodyEmphasis": {
      "size": 17,
      "weight": "semibold",
      "lineHeight": 26,
      "relativeTo": "body",
      "usage": "주 행동",
      "tracking": 0
    },
    "secondary": {
      "size": 15,
      "weight": "regular",
      "lineHeight": 22,
      "relativeTo": "subheadline",
      "usage": "보조 정보",
      "tracking": 0
    },
    "caption": {
      "size": 13,
      "weight": "medium",
      "lineHeight": 20,
      "relativeTo": "footnote",
      "usage": "상태",
      "tracking": 0
    },
    "meta": {
      "size": 12,
      "weight": "medium",
      "lineHeight": 18,
      "relativeTo": "caption1",
      "usage": "분류",
      "tracking": 0
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "screen": 24,
    "screenCompact": 16,
    "section": 32,
    "row": 16,
    "inline": 8,
    "modal": 24,
    "safeBottom": 16
  },
  "radius": {
    "control": 8,
    "container": 16,
    "modal": 24
  },
  "border": {
    "hairline": 0.5,
    "control": 1,
    "focus": 2
  },
  "elevation": {
    "content": "none",
    "presentation": "system"
  },
  "layout": {
    "referenceWidth": 390,
    "minimumWidth": 320,
    "compactBreakpoint": 350,
    "minimumTapTarget": 44,
    "safeArea": "system"
  },
  "motion": {
    "quick": 180,
    "standard": 240,
    "sheet": 320,
    "reduced": 80,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduceMotion": "opacityOnly"
  },
  "symbols": {
    "today": "sun.max",
    "week": "calendar",
    "library": "square.stack",
    "records": "text.book.closed",
    "settings": "gearshape",
    "start": "play.fill",
    "pause": "pause.fill",
    "complete": "checkmark",
    "add": "plus",
    "back": "chevron.left",
    "forward": "chevron.right",
    "more": "ellipsis",
    "timer": "timer",
    "notification": "bell",
    "calendarApplied": "calendar.badge.checkmark",
    "warning": "exclamationmark.circle",
    "retry": "arrow.clockwise",
    "external": "arrow.up.right",
    "close": "xmark"
  },
  "format": "hanju.semantic-tokens.v1"
}
